<Project>

  <!--
    隐藏第三方 NuGet 包"链接"(该 <Link>)进项目的虚拟项。
    典型情况:
      Paway.Runtime.CefSharp        -> runtime\*\*.*  被 Link 成 locales\...
      SQLitePCLRaw.lib.e_sqlite3    -> runtimes\win-*\native\e_sqlite3.dll
    这些项都没有声明 Visible=false，Visual Studio 会把它们渲染成项目下的
    locales / runtimes 之类的"假文件夹"。

    本文件由 Microsoft.Common.targets 在 NuGet 包 targets 之后导入，
    因此这里的 Update 能命中包内声明的项。这里只改可见性，
    不删除项，所以"复制到输出目录"的行为完全不变。
  -->
  <ItemGroup>
    <None Update="@(None)">
      <Visible Condition="'%(Link)' != ''">false</Visible>
    </None>
    <Content Update="@(Content)">
      <Visible Condition="'%(Link)' != ''">false</Visible>
    </Content>
  </ItemGroup>

  <!--
    net462/net48 下同时引用 .NET Framework 程序集与 netstandard2.0 包时，
    ResolveAssemblyReference 会对 mscorlib 报 MSB3277 版本冲突。
    实际结果是选中主版本 mscorlib 4.0.0.0（正确行为），属信息性诊断，
    不影响编译产物与运行时表现。

    抑制放在各 csproj 的 NoWarn 里（追加式 $(NoWarn);MSB3277）：
    这里不能用 Directory.Build.props 直接赋值，各项目是 <NoWarn>xxx</NoWarn>
    整体覆盖的写法会把 props 的值冲掉；也不能用 BeforeTargets target 补，
    RAR 的警告不读那个时机设置的属性。
  -->

</Project>
