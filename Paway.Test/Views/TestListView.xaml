<Page x:Class="Paway.Test.TestListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Paway.Test"
      xmlns:model="clr-namespace:Paway.Model;assembly=Paway.Model"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
      mc:Ignorable="d" 
      UseLayoutRounding="True"
      DataContext="{Binding TestListView, Source={StaticResource Locator}}"
      d:DesignHeight="450" d:DesignWidth="600"
      Title="Empty">
    <Border BorderBrush="LightGray" Margin="20" Background="{StaticResource ThemeBackground}">
        <ListViewEXT IsLight="True" Type="Color" ItemTextForeground="White" Width="238"
                     ItemWidth="80" ItemHeight="80" ItemBackground="200;160;240" ItemTextFontSize="17"
                     ItemImageWidth="24" ItemImageStretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ItemImageDock="Right">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding SelectionCommand}" PassEventArgsToCommand="True"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ListBoxItemEXT Text="A" Desc="Desc" ItemRadius="16,0,0,0"/>
            <ListBoxItemEXT Text="B"/>
            <ListBoxItemEXT Text="C" ItemRadius="0,16,0,0" />
            <ListBoxItemEXT Text="D" />
            <ListBoxItemEXT Tag="收缩" ItemPadding="0,19,0,0" />
            <ListBoxItemEXT Text="E" />
            <ListBoxItemEXT Text="F" ItemRadius="0,0,0,16" />
            <ListBoxItemEXT Text="G" />
            <ListBoxItemEXT Text="。" ItemRadius="0,0,16,0" />
        </ListViewEXT>
    </Border>
</Page>
