<Page x:Class="Paway.Test.TestButton"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Paway.Test"
      xmlns:model="clr-namespace:Paway.Model;assembly=Paway.Model"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
      mc:Ignorable="d" 
      UseLayoutRounding="True"
      DataContext="{Binding TestButton, Source={StaticResource Locator}}"
      d:DesignHeight="450" d:DesignWidth="600"
      Title="TestButton">
    <Border BorderBrush="LightGray" Margin="20" Background="{StaticResource ThemeBackground}">
        <StackPanel >

            <TransitionControl Name="transition" Height="0">
                <Path Style="{StaticResource PathRound}" Fill="Red"/>
            </TransitionControl>
            <ButtonEXT Name="btnCancel" Content="取消"  
                       Type="Warn" IsLight="True" Click="Cancel_Click" 
                       Image="pack://application:,,,/Paway.Test;component/Images/close.png|pack://application:,,,/Paway.Test;component/Images/close_white.png"/>

            <Grid>
                <ButtonEXT Name="btn" Click="Commit_Click" Content="{FontImage Type=Adjust}" Height="30"/>
                <Badge Name="badge" IsWaving="True" HorizontalAlignment="Right" Text="1" Background="{StaticResource Error}" Height="20" Margin="-6" VerticalAlignment="Top"/>
            </Grid>

            <ButtonEXT Content="Success"  Type="Success"/>
            <ButtonEXT Content="Error"  Type="Error"/>
            
        </StackPanel>
    </Border>
</Page>
