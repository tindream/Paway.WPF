<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net48</TargetFrameworks>
		<!--不自动生成程序集信息(版本号)-->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<AssemblyName>Paway.Test</AssemblyName>
		<RootNamespace>Paway.Test</RootNamespace>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>..\bin\$(Configuration)\Test</OutputPath>
		<NoWarn>NU1900;IDE0130</NoWarn>
		<!-- 清除全部语言目录 -->
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<!-- NPOI 传递依赖的 SkiaSharp Linux/Android 原生库,Windows 端用不到 -->
		<ShouldIncludeNativeSkiaSharp>false</ShouldIncludeNativeSkiaSharp>
	</PropertyGroup>
	<PropertyGroup>
		<!--禁止自动生成绑定重定向-->
		<!--<AutoGenerateBindingRedirects>False</AutoGenerateBindingRedirects>-->
	</PropertyGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!--删除.config文件-->
		<!--<Exec Command="del $(TargetDir)$(AssemblyName).exe.config" />-->
	</Target>

	<ItemGroup>
		<Compile Include="..\AssemblyVersion.cs">
			<Link>Properties\AssemblyVersion.cs</Link>
		</Compile>
		<None Update="Log.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Images\**" />
		<Resource Include="Resources\script.sql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Paway.Model\Paway.Model.csproj" />
		<ProjectReference Include="..\Paway.WPF\Paway.WPF.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
	</ItemGroup>

</Project>